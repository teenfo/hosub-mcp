# hosub-mcp 리버스 프록시 (Caddy)
#
# 공인 HTTPS 노출 + 자동 TLS. Caddy 가 Let's Encrypt/ZeroSSL 에서 인증서를
# 자동 발급·갱신하고, 내부의 평문 uvicorn(127.0.0.1:8700)으로 프록시한다.
#
# ⚠️ iptime DDNS(*.iptime.org) 는 사용할 수 없다.
#    iptime 이 도메인 전체에 CAA 레코드(CAA 0 issue ";")를 걸어 모든 CA 의
#    인증서 발급을 차단하기 때문이다(사용자가 못 바꿈). 대신 같은 집 IP를
#    가리키는 DuckDNS 서브도메인을 쓴다. → docs/SETUP.md 부록 B 참고.
#
# 설치:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   # 아래 hosub.duckdns.org 를 본인 DuckDNS 서브도메인으로 교체
#   sudo systemctl restart caddy
#
# 전제:
#   - iptime 공유기에서 외부 80, 443 → 192.168.0.3(서버)로 포트포워딩
#   - hosub.duckdns.org 가 집 공인 IP를 가리킴 (duckdns-update.timer 로 자동 갱신)

hosub.duckdns.org {
	# 대시보드(웹 UI·트레이딩 프록시)는 :8701(hosub-dash.service),
	# 그 외(/mcp, OAuth /authorize·/token·/register·/.well-known)는
	# :8700(hosub-mcp.service). 프로세스를 분리해 대시보드 배포·재시작이
	# MCP 세션을 끊지 않는다.
	# 공유 LLM 게이트웨이(:8603) — 집 밖에서 도는 소비자용.
	# roxlogy 는 Vercel 에서 서비스되므로 고정 출발 IP가 없어 IP 허용목록을
	# 만들 수 없다. Bearer 토큰 + 서비스별 레이트리밋이 유일한 통제다.
	#
	# /v1/* 만 연다. /healthz 는 굳이 공개할 이유가 없다.
	# 토큰이 새도 피해는 "맥 GPU 소모"까지고 서버가 장악되지는 않는다.
	#
	# ⚠️ CORS 를 열지 않는다 — 브라우저가 게이트웨이를 직접 부르면 토큰이
	#    노출된다. 소비자는 자기 서버 사이드 라우트에서만 호출해야 한다.
	handle_path /llm/* {
		route {
			# ⚠️ 순서가 의미를 갖는다(route 는 위에서 아래로 평가). 관리 API
			#    차단이 반드시 @api 프록시보다 **앞**에 있어야 한다.
			#
			#    /v1/admin/* 은 역할의 모델 교체·모델 삭제·임의 모델 설치를 한다.
			#    토큰 한 개가 새면 "맥의 모델 전부 삭제 + 수십 GB 다운로드" 까지
			#    가능해지므로 토큰 게이트만으로는 부족하다. 아예 공개 경로에서
			#    존재하지 않게 만든다 — 관리 기능은 127.0.0.1:8603 으로만 닿는다
			#    (대시보드·MCP 가 쓰는 바로 그 주소라 깨지는 것이 없다).
			@admin path /v1/admin/*
			respond @admin "not found" 404

			@api path /v1/*
			reverse_proxy @api 127.0.0.1:8603 {
				# XFF 를 덮어쓴다. 그러지 않으면 클라이언트가 보낸 값이 앞에 남아
				# 게이트웨이의 "인증 실패 from <IP>" 로그를 위조할 수 있다.
				# (최신 Caddy 는 기본으로 걸러주지만 버전에 기대지 않는다)
				header_up X-Forwarded-For {remote_host}
			}
			respond "not found" 404
		}
	}

	# jw-mcp 라우팅 (127.0.0.1:8604, jw-mcp.service).
	#
	# ⚠️ 이 블록은 서버에는 있었지만 이 파일에는 없었다. 그 상태에서
	#    vpn-singbox-install.sh 가 "@vpn 마커 없음 → 레포판으로 교체"를 실행하면
	#    jw 라우팅이 통째로 사라진다. caddy validate 는 문법만 보므로 통과해버려
	#    롤백도 안 걸린다. 재발 방지로 **실서버 설정을 여기로 되돌려 커밋**한다.
	#    → /etc/caddy/Caddyfile 을 바꿨으면 반드시 이 파일에도 반영할 것.
	#
	# ⚠️ handle_path 가 아니라 handle 을 쓴다. 프리픽스를 벗기지 않고 그대로 넘겨야
	#    앱이 만드는 절대 URL(issuer·redirect·Set-Cookie Path)이 공개 주소와 일치한다.

	# 1) 서비스 본문 — MCP·OAuth·계정 화면이 전부 /jw 아래에 있다.
	@jw path /jw /jw/*
	handle @jw {
		reverse_proxy 127.0.0.1:8604 {
			# 클라이언트가 보낸 XFF 를 신뢰하지 않는다(로그 위조 방지).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 2) OAuth 디스커버리 정본 경로.
	#
	#    issuer 가 https://hosub.duckdns.org/jw 이므로 RFC 8414/9728 이 정한 메타데이터
	#    주소는 루트의 /.well-known/<타입>/jw... 다. 이 두 줄이 없으면 그 요청이 맨 끝
	#    catch-all 을 타고 :8700(hosub-mcp)으로 가서, 커넥터가 엉뚱한 인증 서버를 만난다.
	#
	#    루트의 /.well-known/oauth-authorization-server (접미사 없는 것)는 손대지 않는다 —
	#    그건 hosub 자신의 것이고 그대로 :8700 으로 가야 한다.
	@jw_wellknown path /.well-known/oauth-authorization-server/jw /.well-known/openid-configuration/jw /.well-known/oauth-protected-resource/jw /.well-known/oauth-protected-resource/jw/*
	handle @jw_wellknown {
		reverse_proxy 127.0.0.1:8604
	}

	# 참고: /api/dash/* 는 **일부러 라우팅하지 않는다.** 대시보드용 내부 API 는
	#       127.0.0.1:8604 에서만 보여야 하며, hosub 대시보드(:8701)가 서버 안에서
	#       직접 호출한다. 여기에 경로를 추가하면 그 경계가 무너진다.

	# 검열우회 VPN(sing-box) — **비밀 경로 하나만** 여기로 샌다.
	#
	# 중국처럼 WireGuard/Tailscale 이 막히는 망에서 쓰는 2차 수단이다. VLESS 를
	# WebSocket 에 실어 이 443/TLS 로 흘리면 밖에서는 이 사이트에 대한 평범한
	# HTTPS 요청 하나로 보인다. 공유기에 새 포트를 열 수 없어서(80/443만 열림,
	# 사용자가 중국에 있어 iptime 관리자에 못 닿음) 443 공유가 유일한 길이었다.
	#
	# 경로를 이 파일에 박지 않는다 — 커밋되는 파일이라 비밀이 깃에 남는다.
	# 값은 systemd 드롭인(/etc/systemd/system/caddy.service.d/hosub-vpn.conf)이
	# 환경변수로 주입한다. ⚠️ 그래서 반영은 reload 가 아니라 **restart** 여야 한다.
	#
	# 미설치 상태에서도 안전하다: 환경변수가 없으면 아무도 안 부르는 기본 경로가
	# 되고, 그 경로는 8605 가 안 떠 있어 502 만 낸다(다른 경로는 정상 서비스).
	#
	# ⚠️ @dash 보다 **위**에 있어야 한다. handle 은 위에서부터 배타적으로 걸리므로
	#    비밀 경로가 /api/* 같은 모양이면 아래에 둘 때 대시보드가 먼저 채간다.
	@vpn path {$HOSUB_VPN_PATH:/__vpn-not-configured}
	handle @vpn {
		reverse_proxy 127.0.0.1:8605
	}

	@dash path / /login /logout /favicon.ico /api/* /static/*
	handle @dash {
		reverse_proxy 127.0.0.1:8701
	}
	handle {
		reverse_proxy 127.0.0.1:8700
	}

	# 인증서 발급 알림용 이메일(선택, 권장). 본인 이메일로 교체.
	# tls your-email@example.com

	# 접근 로그(선택)
	log {
		output file /var/log/caddy/hosub-mcp.log
		format console
	}

	# 참고: MCP는 Bearer 토큰으로, 대시보드는 세션 로그인으로 이미 보호된다.
	# 추가로 특정 IP만 허용하려면 아래 주석을 참고해 조정한다.
	# @blocked not remote_ip 1.2.3.4 5.6.7.0/24
	# respond @blocked "forbidden" 403
}
