# --- 키움 REST API ---
# mock = 모의투자(mockapi.kiwoom.com), real = 실전(api.kiwoom.com)
KIWOOM_ENV=mock
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 주문 계좌번호 (모의투자 계좌부터!)
KIWOOM_ACCOUNT=

# --- 대시보드 ---
DASH_PASSWORD=change-me
SESSION_SECRET=change-me-too
# hosub-mcp 대시보드에서 프록시 접근 시 사용 (양쪽에 같은 값:
# 여기 INTERNAL_TOKEN = hosub-mcp 의 HOSUB_TRADING_TOKEN)
INTERNAL_TOKEN=

# --- TNM(뉴스·공시) 호출 ---
# 발굴 엔진의 news 어댑터가 TNM 의 GET /api/items 를 읽는다.
# TNM_TOKEN 은 **tnm/.env 의 INTERNAL_TOKEN 과 같은 값**이다 —
# 위의 INTERNAL_TOKEN(이 서비스 자신의 것)과는 다르다. 자기 것을 보내면 401.
TNM_URL=http://127.0.0.1:8602
TNM_TOKEN=

# --- 데이터 ---
# 홈서버에서는 /data/trading 권장 (1.8TB 디스크)
DATA_DIR=./data
