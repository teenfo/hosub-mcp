# TNM 환경변수 — 실제 값은 tnm/.env (gitignore, chmod 600)
DART_API_KEY=
# 네이버 검색 API 는 선택 — 비우면 구글 뉴스 RSS 만 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Mac Studio Ollama (LAN). 폴백은 hosub 로컬 — 미설치면 비워둔다.
OLLAMA_URL=http://192.168.0.0:11434
OLLAMA_FALLBACK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Postgres (tnm/deploy/docker-compose.yml 의 컨테이너)
TNM_DB_PASSWORD=change-me
TNM_DB_DSN=postgresql://tnm:change-me@127.0.0.1:5433/tnm
# 대시보드 프록시 공유 시크릿 (dash 의 HOSUB_TNM_TOKEN 과 동일 값)
INTERNAL_TOKEN=
# 트레이딩 서비스 연동 (감시목록·보유계좌)
TRADING_URL=http://127.0.0.1:8600
TRADING_TOKEN=
DATA_DIR=/opt/hosub-tnm-data
