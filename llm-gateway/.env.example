# 맥 스튜디오 Ollama 주소 (LAN IP — DHCP 고정 할당 권장)
# 맥에서 외부 접속 허용 필요: launchctl setenv OLLAMA_HOST 0.0.0.0
OLLAMA_URL=http://192.168.0.x:11434

# 두 레인에서 동시에 도는 모델 크기 합의 상한(GB). 48GB 기준 40 권장.
MEM_BUDGET_GB=40

# 백엔드 실패 시 재시도 횟수 (지수 백오프 2s→4s→8s)
MAX_RETRIES=3

# 미설치 모델을 만나면 설치 요청을 만들고, 승인 시 맥에 자동 설치한다.
# 0 으로 두면 이 기능이 꺼지고 예전처럼 그냥 실행을 시도한다.
AUTO_INSTALL_MODELS=1

LOG_LEVEL=INFO

# 서비스 토큰 (openssl rand -hex 32). services.yaml 의 token_env 와 이름이 맞아야 한다.
LLMGW_TOKEN_HOSUB=
LLMGW_TOKEN_ROXLOGY=
LLMGW_TOKEN_TNM=
LLMGW_TOKEN_TRADING=
