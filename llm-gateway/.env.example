# 맥 스튜디오 Ollama 주소 — macstudio 의 Tailscale IP.
# LAN IP(192.168.0.31)는 DHCP 라 바뀔 수 있어 tailnet 주소를 쓴다.
# 맥 쪽 준비(외부 바인딩·슬립 방지·키 만료 해제)는 docs/mac-setup.md 참고.
OLLAMA_URL=http://100.69.201.28:11434

# 두 레인에서 동시에 도는 모델 크기 합의 상한(GB). 48GB 기준 40 권장.
MEM_BUDGET_GB=40

# 백엔드 실패 시 재시도 횟수 (지수 백오프 2s→4s→8s)
MAX_RETRIES=3

# 미설치 모델을 만나면 설치 요청을 만들고, 승인 시 맥에 자동 설치한다.
# 0 으로 두면 이 기능이 꺼지고 예전처럼 그냥 실행을 시도한다.
AUTO_INSTALL_MODELS=1

LOG_LEVEL=INFO

# 완료된 잡·사용량 보존 기간(일). 지나면 자동 정리 — 안 하면 DB 가 무한히 커진다.
JOB_RETENTION_DAYS=30

# --- Slack 알림 (선택) ---
# 사람이 개입해야 하는 순간에만 보낸다:
#   1) 모델 설치 승인 대기 — 안 보면 잡이 계속 멈춰 있다
#   2) 맥 백엔드 오프라인/복구 — 잠자기·정전이면 야간 배치가 조용히 실패한다
# 비워두면 알림 기능이 꺼진다(오류 아님).
# Slack → Apps → Incoming Webhooks 에서 채널별 URL 발급.
# ⚠️ 이 URL 을 아는 사람은 해당 채널에 글을 쓸 수 있다 — .env 밖으로 내지 말 것.
SLACK_WEBHOOK_URL=

# 서비스 토큰 (openssl rand -hex 32). services.yaml 의 token_env 와 이름이 맞아야 한다.
LLMGW_TOKEN_HOSUB=
LLMGW_TOKEN_ROXLOGY=
LLMGW_TOKEN_TNM=
LLMGW_TOKEN_TRADING=
